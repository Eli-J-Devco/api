				#{time},
			</if>
			<if test="id_device != null">
				#{id_device},
			</if>			
			<if test="WAN_IP != null">
				#{WAN_IP},
			</if>
		</trim>


		<trim prefix="ON DUPLICATE KEY UPDATE " suffix=""
			suffixOverrides=",">
			<if test="id_device != null">
				`id_device` = #{id_device},
