<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="AnalyticalReportTracker">

	<insert id="insertStatus" useGeneratedKeys="true" keyProperty="id">
		INSERT INTO `analytical_report_tracker`(
			`id_site`,
			`status`,
			`pause_reason`,
			`notes`,
			`report_cadence`,
			`start_date`,
			`end_date`,
			`keep_cycle`,
			`recipient_to`,
			`recipient_cc`,
			`modified_date`,
			`modified_by`
		)VALUES(
			#{id_site},
			#{status},
			#{pause_reason},
			#{notes},
			#{report_cadence},
			#{start_date},
			#{end_date},
			#{keep_cycle},
			#{recipient_to},
			#{recipient_cc},
			UTC_TIMESTAMP(),
			#{modified_by}
		)
	</insert>

	<update id="updateStatus">
		UPDATE `analytical_report_tracker`
		SET
			`id_site` = #{id_site},
			`status` = #{status},
			`pause_reason` = #{pause_reason},
			`notes` = #{notes},
			`report_cadence` = #{report_cadence},
			`start_date` = #{start_date},
			`end_date` = #{end_date},
			`keep_cycle` = #{keep_cycle},
			`recipient_to` = #{recipient_to},
			`recipient_cc` = #{recipient_cc},
			`modified_date` = UTC_TIMESTAMP(),
			`modified_by` = #{modified_by}
		WHERE `id` = #{id}
	</update>

	<sql id="selectDetailFields">
		SELECT
			art.id,
			art.id_site,
			art.status,
			art.pause_reason,
			art.notes,
			art.report_cadence,
			art.start_date,
			art.end_date,
			art.keep_cycle,
			art.recipient_to,
			art.recipient_cc,
			DATE_FORMAT(CONVERT_TZ(art.modified_date, 'UTC', t.value), '%Y-%m-%d %H:%i:%s') AS modified_date,
			art.modified_by,
			CONCAT_WS(' ', e.first_name, e.last_name) AS modified_by_name
	</sql>

	<sql id="selectDetailTables">
		FROM
			analytical_report_tracker art
			JOIN site s ON s.id = art.id_site
			JOIN time_zone t ON t.id = s.id_time_zone
			LEFT JOIN employee e ON e.id = art.modified_by
	</sql>

	<select id="getDetailById" resultType="com.nwm.api.entities.AnalyticalReportTrackerEntity" parameterType="com.nwm.api.entities.AnalyticalReportTrackerEntity">
		<include refid="selectDetailFields"/>
		<include refid="selectDetailTables"/>
		WHERE
			art.id = #{id}
		LIMIT 1
	</select>
</mapper>
